---
import Layout from '~/layouts/PageLayout.astro';

import { Picture } from '@astrojs/image/components';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Content2 from '~/components/widgets/Content2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Exostic — Ingénierie Produit, Software et Système',
  description:
    "Exostic accompagne grands groupes, PME et startups dans leurs projets d'ingénierie produit, logiciel et système : organisation, architecture fullstack, DevOps et méthodes agiles.",
  dontUseTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    callToAction={{
      text: 'PRENDRE UN RENDEZ-VOUS',
      href: 'https://calendly.com/jeremy-exostic/30min',
      icon: 'tabler:message-star',
    }}
    image={{ src: import('~/assets/images/new-background.png'), alt: 'Exostic' }}
  >
    <Fragment slot="title">
      Ingénierie <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#ff5211] via-[#e43b7d] to-[#4c3584] dark:text-white dark:bg-none">Produit</span>, <span
        class="bg-clip-text text-transparent bg-gradient-to-r from-[#ff5211] via-[#e43b7d] to-[#4c3584] dark:text-white dark:bg-none">Software</span
      > et <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#ff5211] via-[#e43b7d] to-[#4c3584] dark:text-white dark:bg-none">Système</span>
    </Fragment>

    <Fragment slot="subtitle">
      Concevez un produit solide grâce à des méthodes rigoureuses, pensées pour répondre aux besoins réels de vos clients.
    </Fragment>
  </Hero>

  <Features2
    id="services"
    title="Notre savoir-faire"
    subtitle="Une expertise forgée en 10 ans de projets menés pour tout type de structure : grands groupes, PME et startups."
    tagline="Services"
    items={[
      {
        title: 'Organisation',
        description: 'Placez vos projets au cœur de votre stratégie grâce à une approche digitale sur-mesure.',
        icon: 'flat-color-icons:home',
      },
      {
        title: 'Équipe',
        description:
          'Recrutez, encadrez et faites grandir des équipes capables de répondre à vos enjeux techniques.',
        icon: 'flat-color-icons:conference-call',
      },
      {
        title: 'Clients',
        description:
          "Restez à l'écoute de vos clients pour répondre précisément à leurs besoins, sans jamais perdre vos objectifs de vue.",
        icon: 'flat-color-icons:faq',
      },
      {
        title: 'Produit',
        description: 'Transformez un besoin métier en solution logicielle concrète, pilotée par vos KPI.',
        icon: 'flat-color-icons:video-projector',
      },
      {
        title: 'Logiciel',
        description:
          'Concevez des fonctionnalités qui satisfont durablement vos utilisateurs, dans la durée.',
        icon: 'flat-color-icons:smartphone-tablet',
      },
      {
        title: 'Système',
        description:
          "Concevez, faites évoluer et supervisez vos systèmes à chaque étape du projet.",
        icon: 'flat-color-icons:mind-map',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="w-full h-full bg-[#0b012e]"></div>
    </Fragment>
  </Features2>

  <!-- Note Widget ******************* -->

  <!-- <Note /> -->

  <!-- Features Widget *************** -->

  <Features
    id="domains"
    tagline="Domaines"
    title="Votre métier"
    subtitle="Votre métier est la pierre angulaire de toute conception logicielle. En comprenant votre domaine en profondeur, nous construisons des solutions qui répondent avec précision à vos enjeux."
    items={[
      {
        title: 'Logistique',
        description:
          "Gestion des stocks, des entrepôts et des tournées de livraison, prévisions d'approvisionnement et pilotage des commandes fournisseurs.",
        icon: 'tabler:truck',
      },
      {
        title: 'E-commerce',
        description:
          'Catalogue produits, comptes utilisateurs multi-moyens de paiement, gestion des prix et des promotions.',
        icon: 'tabler:basket',
      },
      {
        title: 'Jeux vidéo',
        description:
          "Lobby, joueurs, règles du jeu et scores : conception de l'interface, de l'expérience utilisateur et du game design.",
        icon: 'tabler:device-gamepad',
      },
      {
        title: 'Internet of Things',
        description:
          "Capteurs, terminaux, nœuds réseau (gateways, répéteurs), widgets de restitution et gestion du temps réel.",
        icon: 'tabler:home-share',
      },
      {
        title: 'Apprentissage',
        description:
          "Serious games, contenus de vulgarisation, outils de partage de connaissances, dans le respect des contraintes de l'Éducation nationale.",
        icon: 'tabler:book',
      },
      {
        title: 'Réseaux sociaux',
        description:
          "Scalabilité, gestion des fils d'actualité, authentification et gestion des profils utilisateurs.",
        icon: 'tabler:social',
      },
      {
        title: 'Big Data',
        description:
          'Data warehouses, scalabilité, visualisation, modélisation et gestion des bases de données.',
        icon: 'tabler:chart-arrows-vertical',
      },
      {
        title: 'Ressources humaines',
        description: 'Qualification des besoins et des profils, matching et sourcing de candidats.',
        icon: 'tabler:users-plus',
      },
      {
        title: 'Défense',
        description: 'OSINT, GEOINT, cartographie et détection par intelligence artificielle.',
        icon: 'tabler:shield',
      },
      {
        title: 'Votre métier...',
        description:
          "Découverte de votre domaine métier : concepts, processus, cas d'usage et événements clés.",
        icon: 'tabler:plus',
      },
    ]}
  />

  <!-- Call to Action Widget ********* -->

  <CallToAction
    title="Un projet en tête ?"
    subtitle="Discutons de votre besoin en 30 minutes, sans engagement."
    callToAction={{
      text: 'PRENDRE UN RENDEZ-VOUS',
      href: 'https://calendly.com/jeremy-exostic/30min',
      icon: 'tabler:message-star',
    }}
  />

  <!-- Content Widget **************** -->

  <Content
    id="solutions"
    tagline="Solutions"
    title="Au cœur de la solution"
    items={[
      {
        title: 'Architecture FULLSTACK',
        description:
          "Concevoir une architecture cohérente pour l'application, définir les interactions entre frontend et backend, et choisir les technologies adaptées pour garantir une intégration fluide et une communication efficace entre les composants.",
      },
      {
        title: 'Programmation BACK-END',
        description:
          "Le back-end porte la logique métier, la gestion des données et le traitement des requêtes serveur : création d'APIs, administration des bases de données et sécurisation des accès.",
      },
      {
        title: 'Programmation FRONT-END',
        description:
          "Le front-end façonne l'interface avec laquelle vos utilisateurs interagissent : conception des pages, fonctionnalités interactives et expérience utilisateur, pour un résultat à la fois intuitif et attrayant.",
      },
    ]}
    image={{
      src: import('~/assets/images/caos.png'),
      alt: 'Illustration du développement fullstack',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Développement Fullstack</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Collaboration étroite entre développement et opérations',
        description:
          "Nous encourageons une communication transparente entre équipes de développement et d'exploitation, pour effacer les silos traditionnels et adopter une approche globale du développement, du déploiement et de la gestion des applications.",
      },
      {
        title: 'Automatisation des processus',
        description:
          "Nous automatisons les tâches répétitives à chaque étape du cycle de développement : tests, déploiement, supervision et gestion des infrastructures, pour livrer plus vite et avec plus de qualité.",
      },
      {
        title: 'Amélioration continue',
        description:
          "Nous cultivons une démarche d'amélioration continue, appuyée sur les retours d'expérience et l'analyse des performances. Les équipes identifient rapidement les problèmes et les axes d'amélioration, pour itérer efficacement et livrer des produits de haute qualité.",
      },
    ]}
    image={{
      src: import('~/assets/images/devops.png'),
      alt: 'Illustration de la méthodologie DevOps',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Méthodologie DevOps</h3>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'Itérations et livraisons incrémentales',
        description:
          "Nous travaillons par itérations courtes et régulières. Chacune livre une version fonctionnelle du produit, pour obtenir rapidement des retours utilisateurs et ajuster les priorités en conséquence.",
      },
      {
        title: 'Flexibilité et adaptation aux changements',
        description:
          "Plutôt que de figer un plan détaillé en début de projet, nous restons prêts à faire face à l'évolution des exigences, des priorités et des contraintes, en réévaluant continuellement notre approche pour maximiser la valeur livrée.",
      },
      {
        title: 'Collaboration et communication active',
        description:
          "Nous collaborons étroitement avec l'équipe et les parties prenantes. Une communication active et transparente permet de mieux comprendre les besoins du client et d'obtenir des retours réguliers tout au long du développement, pour un engagement de tous et une vision partagée des objectifs.",
      },
    ]}
    image={{
      src: import('~/assets/images/remote.png'),
      alt: "Illustration de l'organisation agile",
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Organisation Agile</h3>
    </Fragment>
  </Content>

  <Content2 id="technologies" tagline="Technologies" title="Le temps de l'exécution">
    <Fragment slot="content">
      <Picture
        class="mx-auto w-full hero-picture max-w-2xl"
        widths={[400, 768, 1024]}
        sizes="(max-width: 767px) 100vw, 672px"
        aspectRatio={1}
        loading="lazy"
        width={1024}
        height={1024}
        src={import('~/assets/images/technos.png')}
        alt="Technologies maîtrisées par Exostic : langages, frameworks et outils"
      />
    </Fragment>
  </Content2>
</Layout>
