---
import Layout from '~/layouts/PageLayout.astro';

import { Picture } from '@astrojs/image/components';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Content2 from '~/components/widgets/Content2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Exostic — Product, Software and System Engineering',
  description:
    'Exostic helps large companies, SMEs and startups with their product, software and system engineering projects: organization, fullstack architecture, DevOps and agile methods.',
  dontUseTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    callToAction={{
      text: 'BOOK A MEETING',
      href: 'https://calendly.com/jeremy-exostic/30min',
      icon: 'tabler:message-star',
    }}
    callToAction2={}
    image={{ src: import('~/assets/images/new-background.png'), alt: 'Exostic' }}
  >
    <Fragment slot="title">
      Product <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#ff5211] via-[#e43b7d] to-[#4c3584] dark:text-white dark:bg-none">Engineering</span>, <span
        class="bg-clip-text text-transparent bg-gradient-to-r from-[#ff5211] via-[#e43b7d] to-[#4c3584] dark:text-white dark:bg-none">Software</span
      > and <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#ff5211] via-[#e43b7d] to-[#4c3584] dark:text-white dark:bg-none">Systems</span>
    </Fragment>

    <Fragment slot="subtitle">
      Build a solid product with rigorous methods, designed to meet your clients' real needs.
    </Fragment>
  </Hero>

  <Features2
    id="services"
    title="Our Expertise"
    subtitle="Expertise built over 10 years of projects for organizations of every size: large companies, SMEs and startups."
    tagline="Services"
    items={[
      {
        title: 'Organization',
        description: 'Place your projects at the heart of your strategy with a tailored digital approach.',
        icon: 'flat-color-icons:home',
      },
      {
        title: 'Team',
        description:
          'Recruit, lead and grow teams capable of tackling your technical challenges.',
        icon: 'flat-color-icons:conference-call',
      },
      {
        title: 'Clients',
        description:
          "Stay attentive to your clients to precisely address their needs, without ever losing sight of your goals.",
        icon: 'flat-color-icons:faq',
      },
      {
        title: 'Product',
        description: 'Turn a business need into a concrete software solution, driven by your KPIs.',
        icon: 'flat-color-icons:video-projector',
      },
      {
        title: 'Software',
        description:
          'Design features that keep your users satisfied for the long run.',
        icon: 'flat-color-icons:smartphone-tablet',
      },
      {
        title: 'System',
        description:
          "Design, evolve and oversee your systems at every stage of the project.",
        icon: 'flat-color-icons:mind-map',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="w-full h-full bg-[#0b012e]"></div>
    </Fragment>
  </Features2>

  <!-- Note Widget ******************* -->

  <!-- <Note /> -->

  <!-- Features Widget *************** -->

  <Features
    id="domains"
    tagline="Domains"
    title="Your Business"
    subtitle="Your business is the cornerstone of any software design. By understanding your domain in depth, we build solutions that precisely address your challenges."
    items={[
      {
        title: 'Logistics',
        description:
          "Stock, warehouse and delivery route management, supply forecasting and supplier order tracking.",
        icon: 'tabler:truck',
      },
      {
        title: 'E-commerce',
        description:
          'Product catalogs, multi-payment-method user accounts, pricing and promotions management.',
        icon: 'tabler:basket',
      },
      {
        title: 'Video Games',
        description:
          "Lobby, players, game rules and scores: interface design, user experience and game design.",
        icon: 'tabler:device-gamepad',
      },
      {
        title: 'Internet of Things',
        description:
          "Sensors, devices, network nodes (gateways, repeaters), display widgets and real-time management.",
        icon: 'tabler:home-share',
      },
      {
        title: 'Education',
        description:
          "Serious games, educational content, knowledge-sharing tools, in line with national education requirements.",
        icon: 'tabler:book',
      },
      {
        title: 'Social Networks',
        description:
          "Scalability, news feed management, authentication and user profile management.",
        icon: 'tabler:social',
      },
      {
        title: 'Big Data',
        description:
          'Data warehouses, scalability, visualization, database modeling and management.',
        icon: 'tabler:chart-arrows-vertical',
      },
      {
        title: 'Human Resources',
        description: 'Needs and profile qualification, candidate matching and sourcing.',
        icon: 'tabler:users-plus',
      },
      {
        title: 'Defense',
        description: 'OSINT, GEOINT, mapping and AI-based detection.',
        icon: 'tabler:shield',
      },
      {
        title: 'Your business...',
        description:
          "Discovery of your business domain: concepts, processes, use cases and key events.",
        icon: 'tabler:plus',
      },
    ]}
  />

  <!-- Call to Action Widget ********* -->

  <CallToAction
    title="Have a project in mind?"
    subtitle="Let's discuss your needs in a free 30-minute call."
    callToAction={{
      text: 'BOOK A MEETING',
      href: 'https://calendly.com/jeremy-exostic/30min',
      icon: 'tabler:message-star',
    }}
  />

  <!-- Content Widget **************** -->

  <Content
    id="solutions"
    tagline="Solutions"
    title="At the Heart of the Solution"
    items={[
      {
        title: 'FULLSTACK Architecture',
        description:
          "Designing a coherent architecture for the application, defining the interactions between frontend and backend, and choosing the right technologies to ensure smooth integration and efficient communication between components.",
      },
      {
        title: 'BACK-END Development',
        description:
          "The back-end handles business logic, data management and server request processing: building APIs, managing databases and securing access.",
      },
      {
        title: 'FRONT-END Development',
        description:
          "The front-end shapes the interface your users interact with: page design, interactive features and user experience, for a result that's both intuitive and appealing.",
      },
    ]}
    image={{
      src: import('~/assets/images/caos.png'),
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Fullstack Development</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Close Collaboration Between Development and Operations',
        description:
          "We foster transparent communication between development and operations teams, breaking down traditional silos and adopting a holistic approach to developing, deploying and managing applications.",
      },
      {
        title: 'Process Automation',
        description:
          "We automate repetitive tasks at every stage of the development cycle: testing, deployment, monitoring and infrastructure management, to deliver faster and with higher quality.",
      },
      {
        title: 'Continuous Improvement',
        description:
          "We cultivate a continuous improvement mindset, backed by feedback loops and performance analysis. Teams quickly identify issues and areas for improvement, iterating efficiently to deliver high-quality products.",
      },
    ]}
    image={{
      src: import('~/assets/images/devops.png'),
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">DevOps Methodology</h3>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'Iterations and Incremental Delivery',
        description:
          "We work in short, regular iterations. Each one delivers a functional version of the product, allowing us to quickly gather user feedback and adjust priorities accordingly.",
      },
      {
        title: 'Flexibility and Adaptability to Change',
        description:
          "Rather than locking in a detailed plan at the start of a project, we stay ready to adapt to evolving requirements, priorities and constraints, continuously reassessing our approach to maximize delivered value.",
      },
      {
        title: 'Active Collaboration and Communication',
        description:
          "We collaborate closely with the team and stakeholders. Active, transparent communication helps us better understand client needs and gather regular feedback throughout development, fostering engagement from everyone and a shared vision of the goals.",
      },
    ]}
    image={{
      src: import('~/assets/images/remote.png'),
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Agile Organization</h3>
    </Fragment>
  </Content>

  <Content2 id="technologies" tagline="Technologies" title="Time to Execute">
    <Fragment slot="content">
      <Picture
        class="mx-auto w-full hero-picture max-w-2xl"
        widths={[400, 768, 1024, 1024]}
        sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 1024px"
        aspectRatio={1}
        loading="eager"
        width={1024}
        height={1024}
        src={import('~/assets/images/technos.png')}
        alt="exostic-picture-reverted"
      />
    </Fragment>
  </Content2>
</Layout>
