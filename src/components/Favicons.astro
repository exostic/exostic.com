---
import favIcon from '~/assets/favicons/favicon.ico';
import favIconSvg from '~/assets/favicons/favicon.svg';

const svgHref = typeof favIconSvg === 'string' ? favIconSvg : favIconSvg.src;
---

<link rel="shortcut icon" href={favIcon} />
<link rel="icon" type="image/svg+xml" href={svgHref} />
<link rel="mask-icon" href={svgHref} color="#8D46E7" />
<link rel="manifest" href="/site.webmanifest" />
